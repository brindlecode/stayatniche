---
import StayVisual from './StayVisual.astro';
import '../styles/hotel-card.css';
import { hotelDealUrl, AFFILIATE_REL, isExpediaSearch, trackAttrs } from '../lib/affiliate';
import { startPrice, placeLabel } from '../lib/site';
import { getLocale, i18n } from '../i18n';

interface Props {
  name: string; destination: string; country: string; description: string;
  priceRange: string; priceIndicator?: number; rating: number;
  highlights: string[]; bookingUrl: string; slug: string; category: string;
  featured?: boolean; coverImage?: string; class?: string;
  nicheScope?: string; nicheBadge?: string; closed?: boolean;
  /** First row of a listing: load the photo now; priority = it is the page's main (LCP) image. */
  eager?: boolean; priority?: boolean;
}
const { name, destination, country, priceRange, rating, highlights, bookingUrl, slug, category, featured, coverImage, class: cls = '', nicheScope, nicheBadge, closed, eager = false, priority = false } = Astro.props;
const L = i18n(getLocale(Astro.url));
const { t } = L;
const from = startPrice(priceRange);
const place = L.country(country);
const bookUrl = hotelDealUrl(bookingUrl, name, destination, { campaign: 'hotel-card', content: slug });
const isSearch = !!bookUrl && isExpediaSearch(bookUrl);
---
<article class:list={['hotel-card group relative flex flex-col', cls]} data-hotel data-slug={slug} data-name={name.toLowerCase()} data-place={`${destination} ${country} ${place}`.toLowerCase()} data-cat={category} data-cat-name={L.cat(category, category.replace(/-/g, ' ')).toLowerCase()} data-price={from ?? undefined} data-rating={rating} data-featured={featured ? 1 : 0}>
  <div class="hc-media">
    <StayVisual slug={slug} name={name} category={category} destination={destination} country={place} coverImage={coverImage} eager={eager} priority={priority} />
    {featured && <span class="hc-pick">{t.card.editorsPick}</span>}
    <button type="button" data-save={slug} aria-pressed="false" aria-label={t.card.save(name)} class="save-btn hc-save">
      <svg class="hc-heart" fill="none" aria-hidden="true"><use href="#sn-heart" /></svg>
    </button>
  </div>
  <div class="pt-3">
    <div class="hc-head">
      <h3 class="hc-name">
        <a href={L.path('hotels', slug)} class="hc-link">{name}</a>
      </h3>
      {rating != null && (
        <span class="hc-score" title={t.card.scoreTitle} aria-label={`${t.hotel.editorScore}: ${rating.toFixed(1)} / 10`}>{rating.toFixed(1)}</span>
      )}
    </div>
    <p class="hc-place">{placeLabel(destination, country, place)}</p>
    {highlights?.[0] && <p class="hc-hl">{highlights[0]}</p>}
    {(closed || nicheScope === 'specific_rooms') && (
      <p class="hc-badges">
        {closed && <span data-closed class="hc-closed">{t.hotel.closure.title}</span>}
        {nicheScope === 'specific_rooms' && <span data-niche-badge class="hc-rooms">{nicheBadge || t.card.onlySome}</span>}
      </p>
    )}
    <div class="hc-foot">
      <p class="hc-price">{from != null ? <>{t.card.from}{' '}<span class="hc-from">{L.usd(from)}</span> {t.card.perNight}</> : t.card.seeRates}</p>
      {bookUrl && <a href={bookUrl} target="_blank" rel={AFFILIATE_REL} {...trackAttrs(bookUrl, { track: 'booking', placement: 'hotel_card', hotel: slug, category, country })} class="hc-book">{isSearch ? t.card.searchRates : t.card.checkRates}</a>}
    </div>
  </div>
</article>

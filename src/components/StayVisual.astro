---
/**
 * Image area for a stay. Shows the stay's own photo when one exists; otherwise a free-licensed
 * photo taken near it, labelled with the place ("Around Göreme") so it never passes for the hotel;
 * otherwise a typographic "travel label" in the category's tone, unique per stay (place name).
 */
import CategoryIcon from './CategoryIcon.astro';
import '../styles/hotel-card.css';
import { ownPhoto, areaPhoto, CATEGORY_TONE, imgAttrs, SIZES } from '../lib/images';
import { getLocale, i18n } from '../i18n';
/** eager: in the first screen, load now (not lazily). priority: the page's main (LCP) image; defaults to eager. */
interface Props { slug: string; name: string; category: string; destination: string; country: string; coverImage?: string; eager?: boolean; priority?: boolean; size?: 'card' | 'hero'; }
const { slug, name, category, destination, country, coverImage, eager = false, priority = eager, size = 'card' } = Astro.props;
const L = i18n(getLocale(Astro.url));
const photo = ownPhoto(coverImage, slug);
const area = photo ? null : areaPhoto(slug);
const [bg, ink] = CATEGORY_TONE[category] ?? ['#E5E2DA', '#2D2A26'];
const place = destination.split(',')[0].trim();
const hero = size === 'hero';
const sizes = hero ? SIZES.wide : SIZES.card;
---
{photo ? (
  <img {...imgAttrs(photo, sizes)} alt={`${name}, ${destination}`} class="hc-img" loading={eager ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding={eager ? undefined : 'async'} />
) : area ? (
  <div class="relative h-full w-full">
    <img {...imgAttrs(area, sizes)} alt={L.t.card.around(place)} class="hc-img" loading={eager ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding={eager ? undefined : 'async'} />
    <span class:list={['hc-area', hero ? 'hc-area-hero' : 'hc-area-card']}>
      <svg class="hc-pin" fill="none" aria-hidden="true"><use href="#sn-pin" /></svg>
      {L.t.card.around(place)}
    </span>
  </div>
) : (
  <div class="label-card relative flex h-full w-full flex-col justify-between overflow-hidden" style={`background:${bg};color:${ink}`} role="img" aria-label={`${name}, ${destination}`}>
    <CategoryIcon slug={category} size={hero ? 420 : 220} strokeWidth={0.6} class="pointer-events-none absolute -bottom-[18%] -right-[12%] opacity-[.13] transition-transform duration-700 group-hover:rotate-[-6deg]" />
    <div class:list={['flex items-center justify-between', hero ? 'p-8' : 'p-4']}>
      <span class="eyebrow opacity-[.85]">{L.cat(category, category.replace(/-/g, ' '))}</span>
      <CategoryIcon slug={category} size={hero ? 28 : 18} strokeWidth={1.6} />
    </div>
    <div class={hero ? 'p-8' : 'p-4 pt-0'}>
      <p class:list={['font-display leading-[.95]', hero ? 'text-6xl sm:text-7xl' : 'text-[2.1rem]']}>{place}</p>
      <p class:list={['mt-1 font-body font-medium opacity-[.85]', hero ? 'text-base' : 'text-xs']}>{country}</p>
    </div>
  </div>
)}

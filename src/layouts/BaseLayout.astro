---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { getEntry } from 'astro:content';
import { getLocale, i18n, LOCALE_META } from '../i18n';
import { verificationCode } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  heroImage?: string;
  /** srcset/sizes of the hero <img>, so the preload fetches the same file the browser picks. */
  heroSrcset?: string;
  heroSizes?: string;
  noIndex?: boolean;
  /** Hide the mobile bottom tab bar (pages with their own sticky CTA). */
  hideBottomNav?: boolean;
  type?: 'website' | 'article';
  /** ISO date — used for article structured data / og:updated_time. */
  publishedTime?: string;
  updatedTime?: string;
  /** Extra JSON-LD blocks to inject. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Same page in other languages (hreflang). Include this page's own locale. A version marked
   *  indexable: false (thin page) stays in the language menu but is left out of hreflang. */
  alternates?: { locale: string; href: string; indexable?: boolean }[];
  /** Hotel page facts for analytics (hotel_view and click dimensions). No personal data. */
  trackPage?: { hotel: string; category?: string; country?: string };
}

const {
  title,
  description,
  image,
  heroImage,
  heroSrcset,
  heroSizes,
  noIndex = false,
  hideBottomNav = false,
  type = 'website',
  publishedTime,
  updatedTime,
  jsonLd,
  alternates = [],
  trackPage,
} = Astro.props;
const L = i18n(getLocale(Astro.url));
const meta = LOCALE_META[L.locale];

// Load settings from CMS
const seoSettings        = await getEntry('settings', 'seo').catch(() => null);
const genSettings        = await getEntry('settings', 'general').catch(() => null);
const analyticsSettings  = await getEntry('settings', 'analytics').catch(() => null);

const seo        = seoSettings?.data        ?? {};
const gen        = genSettings?.data        ?? {};
const analytics  = analyticsSettings?.data  ?? {};

const siteName  = gen.siteName    || 'StayAtNiche';
const lang      = L.locale;
const canonical = seo.canonicalUrl || 'https://stayatniche.com';

const metaDesc = description || (L.locale === 'en' ? seo.defaultDescription : '') || L.t.meta.defaultDescription;

const ogRaw = image || seo.defaultOgImage || '/og-default.png';
const ogImage = ogRaw.startsWith('/') ? `https://stayatniche.com${ogRaw}` : ogRaw;

const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || canonical);

const twitterHandle = seo.twitterHandle || '@stayatniche';
// Search Console / Bing / Pinterest verification (seo.json, empty by default = no tag).
const googleVerif    = verificationCode(seo.googleVerification);
const bingVerif      = verificationCode(seo.bingVerification);
const pinterestVerif = verificationCode(seo.pinterestVerification);

const socialSettings = await getEntry('settings', 'social').catch(() => null);
const sameAs = Object.values(socialSettings?.data ?? {}).filter((v): v is string => typeof v === 'string' && v.startsWith('http'));
const adsenseClient  = (analytics.adsenseClient as string) || '';
const clarityId      = analytics.clarityId      || '';
const plausibleDomain = analytics.plausibleDomain || '';
const fbPixelId      = analytics.fbPixelId      || '';

const extraLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
// hreflang only between indexable versions, and none on a noindex page (Google ignores or flags them).
const hreflangs = noIndex ? [] : alternates.filter(a => a.indexable !== false);
const xDefault = hreflangs.find(a => a.locale === 'en');
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />

    <!-- Google tag + consent (src/components/Analytics.astro). Loads nothing without IDs or consent. -->
    <Analytics />

    <!-- Travelpayouts Drive (converts partner links to tracked affiliate links). Verbatim from the dashboard. -->
    <script is:inline nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
      (function () {
          var script = document.createElement("script");
          script.async = 1;
          script.setAttribute("data-cmp-ab","2");
          script.src = 'https://emrldco.com/NDc4MzA3.js?t=478307';
          document.head.appendChild(script);
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex
      ? <meta name="robots" content="noindex,follow" />
      : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}
    {googleVerif    && <meta name="google-site-verification" content={googleVerif} />}
    {bingVerif      && <meta name="msvalidate.01" content={bingVerif} />}
    {pinterestVerif && <meta name="p:domain_verify" content={pinterestVerif} />}

    <!-- Open Graph -->
    <meta property="og:type"        content={type} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={title} />
    <meta property="og:site_name"   content={siteName} />
    <meta property="og:locale"      content={meta.og} />
    {hreflangs.filter(a => a.locale !== L.locale).map(a => <meta property="og:locale:alternate" content={LOCALE_META[a.locale as keyof typeof LOCALE_META].og} />)}
    {hreflangs.length > 1 && hreflangs.map(a => <link rel="alternate" hreflang={LOCALE_META[a.locale as keyof typeof LOCALE_META].hreflang} href={new URL(a.href, canonical).href} />)}
    {hreflangs.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.href, canonical).href} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime   && <meta property="article:modified_time"  content={updatedTime} />}

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:site"        content={twitterHandle} />
    <meta name="twitter:creator"     content={twitterHandle} />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image"       content={ogImage} />
    <meta name="twitter:image:alt"   content={title} />

    <!-- Structured Data: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": siteName,
      "url": canonical,
      "logo": {
        "@type": "ImageObject",
        "url": `${canonical}/logo.png`,
        "width": 512,
        "height": 512
      },
      "sameAs": sameAs
    })} />

    <!-- Structured Data: WebSite with SearchAction -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": new URL(L.path('home'), canonical).href,
      "description": metaDesc,
      "inLanguage": meta.intl,
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${new URL(L.path('search'), canonical).href}?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    {extraLd.map(ld => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    <!-- Meta (Facebook) Pixel -->
    {fbPixelId && (
      <script set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${fbPixelId}');fbq('track','PageView');`} />
    )}

    <!-- Microsoft Clarity -->
    {clarityId && (
      <script set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${clarityId}");`} />
    )}

    <!-- Plausible Analytics -->
    {plausibleDomain && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}

    {adsenseClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous"></script>
    )}

    {heroImage && (
      <link rel="preload" as="image" href={heroImage} imagesrcset={heroSrcset} imagesizes={heroSrcset ? heroSizes : undefined} fetchpriority="high" />
    )}

    <!-- Fonts — non-blocking async load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600;700&display=swap" />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#FAF9F6" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="search" type="text/html" href={L.path('search')} title={`${siteName} search`} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — Blog`} href="/rss.xml" />

    <style is:global>
      html { scroll-padding-top: 96px; }
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      /* Legacy decorative texture, retired in the editorial redesign */
      .dot-pattern { display: none; }
      /* Instrument Serif ships one weight: never fake-bold it */
      .font-display { font-weight: 400 !important; letter-spacing: -0.012em; }
      h1.font-display, h2.font-display { letter-spacing: -0.02em; }
      ::selection { background: #FAE2D5; color: #0F0E0C; }
      :focus-visible { outline: 2px solid #1F5C48; outline-offset: 2px; }
      /* On dark sections the green outline is too faint (under 3:1): use a light one. */
      footer :focus-visible, .bg-warm-950 :focus-visible, .bg-forest-950 :focus-visible { outline-color: #FAF9F6; }
      .bg-white :focus-visible { outline-color: #1F5C48; }
      .eyebrow { font: 600 11px/1.2 Geist, system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase; }
      .hairline { border-color: #E5E2DA; }
      .save-btn.is-saved { color: #C9602E; background: #fff; }
      .save-btn.is-saved svg { fill: currentColor; }
      .reveal { opacity: 0; transform: translateY(14px); transition: opacity .6s ease, transform .6s ease; }
      .reveal.in { opacity: 1; transform: none; }
      .snap-row { scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; }
      .snap-row > * { scroll-snap-align: start; }
      @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
      /* Reduce motion for users who prefer it */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body class:list={["bg-warm-50 text-warm-900 font-body antialiased", !hideBottomNav && "pb-16 md:pb-0"]} data-page-hotel={trackPage?.hotel} data-page-category={trackPage?.category} data-page-country={trackPage?.country}>

    <!-- Icons drawn many times per page (hotel cards): defined once here, referenced by id. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="sn-heart" viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3 5.5 6.2 5.5c1.9 0 3.2 1 3.8 2 .6-1 1.9-2 3.8-2 3.2 0 5 3.1 3.7 6.3C19.5 16.4 12 21 12 21Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></symbol>
      <symbol id="sn-pin" viewBox="0 0 24 24"><g stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6-5.3-6-10a6 6 0 1 1 12 0c0 4.7-6 10-6 10Z" /><circle cx="12" cy="11" r="2" /></g></symbol>
    </svg>

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-warm-950 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
      {L.t.common.skip}
    </a>

    <Header alternates={alternates} />
    <main id="main" class="pt-16">
      <slot />
    </main>
    <Footer />
    {!hideBottomNav && <BottomNav />}
    <ConsentBanner />
    <script is:inline>
      // Never show a broken-image icon: swap any failed <img> for a themed placeholder.
      document.addEventListener('error', function (e) {
        var t = e.target;
        if (t && t.tagName === 'IMG' && !t.dataset.fb) {
          t.dataset.fb = '1'; t.removeAttribute('srcset'); t.src = t.dataset.fbSrc || '/images/placeholder.svg';
        }
      }, true);
      document.querySelectorAll('img').forEach(function (i) { if (i.complete && i.naturalWidth === 0 && !i.dataset.fb) { i.dataset.fb = '1'; i.removeAttribute('srcset'); i.src = i.dataset.fbSrc || '/images/placeholder.svg'; } });
    </script>

    <script is:inline>
      // Saved stays (localStorage) + scroll reveal
      (function () {
        var KEY = 'sn_saved';
        function read() { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; } }
        function write(a) { try { localStorage.setItem(KEY, JSON.stringify(a)); } catch (e) {} }
        function paint() {
          var saved = read();
          document.querySelectorAll('[data-save]').forEach(function (b) {
            var on = saved.indexOf(b.getAttribute('data-save')) > -1;
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
            b.classList.toggle('is-saved', on);
          });
          document.querySelectorAll('[data-saved-count]').forEach(function (n) {
            n.textContent = saved.length; n.classList.toggle('hidden', !saved.length);
          });
        }
        document.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('[data-save]');
          if (!b) return;
          e.preventDefault(); e.stopPropagation();
          var slug = b.getAttribute('data-save'), saved = read(), i = saved.indexOf(slug);
          if (i > -1) saved.splice(i, 1); else saved.push(slug);
          write(saved); paint();
          document.dispatchEvent(new CustomEvent('sn:saved-changed'));
        });
        paint();
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (es) { es.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { rootMargin: '0px 0px -8% 0px' });
          document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
        } else { document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); }); }
      })();
    </script>
  </body>
</html>
